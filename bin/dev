#!/usr/bin/env bash
set -e

if command -v foreman >/dev/null 2>&1; then
  # Precompiled assets bypass Propshaft's live development asset path and can
  # leave the browser on stale JS/CSS even while the bundler watchers rebuild.
  bin/rails assets:clobber
  exec foreman start -f Procfile.dev "$@"
fi

echo "foreman is required to run Procfile.dev (gem install foreman or brew install foreman)." >&2
exit 1
