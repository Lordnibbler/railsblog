<div class="section-divider glass-stage dark:bg-primary-20" id="expertise">
    <div class="container py-16 md:py-20">
        <h2
            class="font-header font-semibold text-primary dark:text-primary-1000 text-4xl sm:text-5xl lg:text-6xl uppercase text-center">
            Expertise</h2>
        <h3 class="font-header font-medium text-black dark:text-primary-400 text-xl sm:text-2xl lg:text-3xl pt-6 text-center">
            <%= professional_experience_years.humanize.capitalize %> Years in Creative and Technical Disciplines</h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-3 gap-6 md:gap-10 pt-10 md:pt-12">
            <div class="glass-card glass-card-static px-8 py-12 rounded-xl">
                <div class="text-center w-24 xl:w-28 h-24 xl:h-28 mx-auto">
                    <%= image_tag "home/icon-software-development.svg", alt: "", class: "invert-0 dark:invert" %>
                </div>
                <div class="text-center">
                    <h3
                        class="font-semibold text-lg lg:text-xl text-primary dark:text-primary-1000 primary-500 uppercase pt-8">
                        Software Engineering</h3>
                    <p class="text-sm md:text-base text-grey dark:text-primary-700 pt-4">
                        Scalable frontend and backend systems built on microservices.
                    </p>
                </div>
            </div>

            <div class="glass-card glass-card-static px-8 py-12 rounded-xl">
                <div class="text-center w-24 xl:w-28 h-24 xl:h-28 mx-auto">
                    <%= image_tag "home/icon-app-development.svg", alt: "", class: "invert-0 dark:invert" %>
                </div>
                <div class="text-center">
                    <h3
                        class="font-semibold text-lg lg:text-xl text-primary dark:text-primary-1000 primary-500 uppercase pt-8">
                        <span class="normal-case">iOS</span> Game Development</h3>
                    <p class="text-sm md:text-base text-grey dark:text-primary-700 pt-4">
                        Fast, polished 2D arcade games built with SpriteKit.
                    </p>
                </div>
            </div>

            <div class="glass-card glass-card-static px-8 py-12 rounded-xl">
                <div class="text-center w-24 xl:w-28 h-24 xl:h-28 mx-auto">
                    <%= image_tag "home/icon-filmmaking.svg", alt: "", class: "invert-0 dark:invert" %>
                </div>
                <div class="text-center">
                    <h3
                        class="font-semibold text-lg lg:text-xl text-primary dark:text-primary-1000 primary-500 uppercase pt-8">
                        Film & Photography</h3>
                    <p class="text-sm md:text-base text-grey dark:text-primary-700 pt-4">
                        Product photography, commercial spots, and cinematic short films.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
