<div class="bg-center bg-cover bg-no-repeat relative py-8" data-navigation-contrast="light"
    style="background-image: url(<%= asset_path("home/bg-hero.jpg") %>);">

    <div
        class="bg-center bg-cover bg-no-repeat absolute inset-0 z-20 bg-gradient-to-r from-hero-gradient-from dark:from-hero-gradient-dark-from to-hero-gradient-to dark:to-hero-gradient-dark-to">
    </div>

    <div class="container z-30 relative pt-20 sm:pt-56 lg:pt-64 pb-12 sm:pb-48 lg:pb-48">
        <div class="flex flex-col lg:flex-row justify-center items-center">
            <div class="rounded-full border-8 border-white shadow-xl">
                <%= image_tag "home/blog-author-#{rand(1..5)}.jpg", class: "h-48 w-48 sm:h-56 sm:w-56 rounded-full object-cover", alt: "Portrait of Ben Radler", width: 425, height: 425, fetchpriority: "high" %>
            </div>
            <div class="lg:pl-8 pt-8 sm:pt-10 lg:pt-0">
                <h1
                    class="font-header text-white text-4xl sm:text-5xl md:text-6xl text-center lg:text-left">
                    <div class="font-bold uppercase">Ben Radler</div>
                    <div class="font-thin uppercase">Software Engineer</div>
                </h1>
                <p class="mx-auto lg:mx-0 mt-5 max-w-xl font-body text-white/90 text-lg sm:text-xl text-center lg:text-left leading-relaxed">
                    I build dependable platforms for complex, high-scale systems and bring a creative eye shaped by photography and art to how they work and feel.
                </p>
                <div class="flex flex-col sm:flex-row justify-center lg:justify-start gap-3 mt-6">
                    <a href="#work" x-data x-on:click.prevent="$scroll('#work', { offset: 40 })"
                        class="glass-button font-header font-bold text-white px-6 py-3 rounded uppercase text-center">
                        View my work
                    </a>
                    <a href="#contact" x-data x-on:click.prevent="$scroll('#contact', { offset: 40 })"
                        class="hero-secondary-button font-header font-bold text-white px-6 py-3 rounded uppercase text-center">
                        Start a conversation
                    </a>
                </div>
                <div class="hero-social-bar flex flex-col sm:flex-row justify-center lg:justify-start mx-auto lg:mx-0 mt-5">
                    <div class="flex justify-center sm:justify-start items-center pl-0 md:pl-1">
                        <p class="font-body text-white text-lg uppercase">Find Me Here</p>
                        <div class="hidden sm:block">
                            <i class='bx bx-chevron-right text-yellow text-3xl'></i>
                        </div>
                    </div>
                    <%= render partial: 'shared/social_icons', locals: { icon_classes: 'text-white hover:text-yellow' } %>
                </div>
            </div>
        </div>
    </div>
</div>
