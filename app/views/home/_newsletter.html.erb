<div class="newsletter-section bg-center bg-cover bg-no-repeat relative py-16 lg:py-24 bg-primary" data-navigation-contrast="light"
    style="background-image: url(<%= asset_path("home/bg-cta.jpg") %>);">
    <div
        class="newsletter-scrim bg-center bg-cover bg-no-repeat absolute inset-0 z-20 bg-gradient-to-r from-hero-gradient-from dark:from-hero-gradient-dark-from to-cta-gradient-to">
    </div>
    <div class="container z-30 relative">
        <h3
            class="newsletter-heading font-header text-white text-3xl sm:text-4xl lg:text-5xl uppercase leading-tight text-center tracking-wide">
            Keep <span class="font-bold">up-to-date</span> <br />
            with what I'm up to</h3>
        <%= form_for NewsletterSignup.new, url: newsletter_signups_path, html: { class: "flex flex-col sm:flex-row justify-center mt-6" } do |form| %>
            <%= form.email_field :email, placeholder: 'email', autocomplete: 'email', required: true, class: "newsletter-input w-full sm:w-2/5 lg:w-1/3 font-body text-black px-4 py-3 sm:py-4 rounded" %>
            <div class="hidden" aria-hidden="true">
                <%= text_field_tag 'newsletter_signup[website]', nil, tabindex: -1, autocomplete: 'off' %>
            </div>
            <%= form.submit "Join the Club", class: "glass-button newsletter-button font-body font-bold px-8 py-3 sm:py-4 text-base md:text-lg text-white uppercase rounded sm:ml-2 mt-2 sm:mt-0 cursor-pointer" %>
        <% end %>
    </div>
</div>
