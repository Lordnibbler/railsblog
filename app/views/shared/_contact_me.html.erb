<% form_classes ||= "" %>
<% request_route ||= "" %>
<%= form_for ContactForm.new, url: contact_forms_path(request_route: request_route), validate: true, html: { class: "w-full sm:w-3/4 pt-10 #{form_classes}" } do |f| %>

  <% # this invisible input is required for captcha %>
  <div class="hidden" aria-hidden="true">
    <%= f.text_field :nickname, tabindex: -1, autocomplete: 'off' %>
  </div>

  <div class="flex flex-col md:flex-row gap-x-4">
      <div class="flex-auto">
        <%= f.label :name, 'Name', class: 'contact-label' %>
        <%= f.text_field :name, placeholder: 'Your name', autocomplete: 'name', required: true, class: "contact-input w-full font-body text-black px-4 py-3 rounded mt-2" %>
      </div>
      <div class="flex-auto">
        <%= f.label :email, 'Email', class: 'contact-label block mt-6 md:mt-0' %>
        <%= f.email_field :email, placeholder: 'you@example.com', autocomplete: 'email', required: true, class: "contact-input w-full font-body text-black px-4 py-3 rounded mt-2" %>
      </div>
  </div>

  <%= f.label :message, 'Message', class: 'contact-label block mt-6 md:mt-8' %>
  <%= f.text_area :message, placeholder: 'How can I help?', required: true, class:"contact-input w-full font-body text-black px-4 py-3 rounded mt-2", cols: "30", rows: "10" %>

  <button
    type="submit"
    class="glass-button px-8 py-3 flex justify-center mt-6 rounded items-center">
    <span class="font-header font-bold text-lg text-white uppercase">Send</span>
    <i class='bx bx-chevron-right text-3xl relative -right-2 font-header font-bold text-lg text-white'></i>
  </button>

<% end %>

<div class="contact-details glass-panel flex flex-col lg:flex-row mt-16 overflow-hidden">
  <div class="contact-detail w-full lg:w-1/3 px-6 py-6 sm:py-8">
    <div class="contact-detail-label flex items-center">
      <i class='bx bxl-linkedin text-primary-400 dark:text-primary-1000 text-2xl'></i>
      <p class="font-body font-bold text-primary-400 dark:text-primary-1000 lg:text-lg uppercase pl-2">
        LinkedIn</p>
    </div>
    <p class="font-body font-bold text-primary dark:text-primary-500 lg:text-lg pt-2 text-left">
        <a href="https://www.linkedin.com/in/benradler/">linkedin.com/benradler</a>
    </p>
  </div>
  <div class="contact-detail w-full lg:w-1/3 px-6 py-6 sm:py-8">
    <div class="contact-detail-label flex items-center">
      <i class='bx bx-envelope text-primary-400 dark:text-primary-1000 text-2xl'></i>
      <p class="font-body font-bold text-primary-400 dark:text-primary-1000 lg:text-lg uppercase pl-2">
        Email</p>
    </div>
    <p class="font-body font-bold text-primary dark:text-primary-500 lg:text-lg pt-2 text-left">
      <a href="mailto:info@benradler.com">info@benradler.com</a>
    </p>
  </div>
  <div class="contact-detail w-full lg:w-1/3 px-6 py-6 sm:py-8">
    <div class="contact-detail-label flex items-center">
      <i class='bx bx-map text-primary-400 dark:text-primary-1000 text-2xl'></i>
      <p class="font-body font-bold text-primary-400 dark:text-primary-1000 lg:text-lg uppercase pl-2">
        Location</p>
    </div>
    <p class="font-body font-bold text-primary dark:text-primary-500 lg:text-lg pt-2 text-left">
      Remote in beautiful Oceanside, California
    </p>
  </div>
</div>
