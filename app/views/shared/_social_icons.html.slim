- icon_classes ||= ""

div[class="flex items-center justify-center sm:justify-start"]
  a[href="https://www.linkedin.com/in/benradler/" aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="noopener noreferrer"]
    i[class="bx bxl-linkedin-square text-2xl pt-2 sm:pt-0 #{icon_classes}" aria-hidden="true"]
  a[class="pl-4" href="https://github.com/lordnibbler/" aria-label="GitHub" title="GitHub" target="_blank" rel="noopener noreferrer"]
    i[class="bx bxl-github text-2xl pt-2 sm:pt-0 #{icon_classes}" aria-hidden="true"]
  a[class="pl-4" href="https://stackoverflow.com/users/418864/professormeowingtons" aria-label="Stack Overflow" title="Stack Overflow" target="_blank" rel="noopener noreferrer"]
    i[class="bx bxl-stack-overflow text-2xl pt-2 sm:pt-0 #{icon_classes}" aria-hidden="true"]
  a[class="pl-4" href="https://youtube.com/benradler" aria-label="YouTube" title="YouTube" target="_blank" rel="noopener noreferrer"]
    i[class="bx bxl-youtube text-2xl pt-2 sm:pt-0 #{icon_classes}" aria-hidden="true"]
  a[class="pl-4" href=("#{blog_posts_path(format: :rss)}") aria-label="RSS feed" title="RSS feed"]
    i[class="bx bx-rss text-2xl pt-2 sm:pt-0 #{icon_classes}" aria-hidden="true"]
