- set_meta_tags title: 'Ben Radler - Street Photographer - Photography Gallery',
        description: 'Photography Gallery - San Francisco Bay Area Street Photography'

- content_for :page_title, 'Photography Gallery'

- # editorial introduction and gallery controls
section.photography-hero data-navigation-contrast="light"
  .photography-hero-glow aria-hidden="true"
  .photography-hero-content
    p.photography-kicker Street studies / California & beyond
    h1 Moments between moments.
    .photography-hero-footer
      p A living archive of light, geometry, motion, and the small human stories hiding in plain sight.
      .photography-stat
        strong = @photo_count
        span photographs in the archive

.photography-toolbar aria-label="Gallery display controls"
  .photography-toolbar-inner
    .photography-toolbar-group
      span View
      button.is-active type="button" data-gallery-density="editorial" aria-pressed="true" Editorial
      button type="button" data-gallery-density="mosaic" aria-pressed="false" Mosaic
    .photography-toolbar-status aria-live="polite"
      span data-gallery-visible = @photos.length
      |  frames loaded
    .photography-toolbar-group.photography-mood-controls
      span Mood
      button.is-active type="button" data-gallery-mood="all" aria-pressed="true" All
      button type="button" data-gallery-mood="golden" aria-pressed="false" Golden
      button type="button" data-gallery-mood="nocturne" aria-pressed="false" Nocturne
      button type="button" data-gallery-mood="electric" aria-pressed="false" Electric
      button type="button" data-gallery-mood="soft" aria-pressed="false" Soft
      button type="button" data-gallery-mood="graphic" aria-pressed="false" Graphic
      button type="button" data-gallery-mood="monochrome" aria-pressed="false" Monochrome
    .photography-toolbar-group.photography-subject-controls
      span Subject
      button.is-active type="button" data-gallery-subject="all" aria-pressed="true" All
      button type="button" data-gallery-subject="people" aria-pressed="false" People
      button type="button" data-gallery-subject="animals" aria-pressed="false" Animals
      button type="button" data-gallery-subject="street" aria-pressed="false" Street
      button type="button" data-gallery-subject="landscape" aria-pressed="false" Landscape
      button type="button" data-gallery-subject="architecture" aria-pressed="false" Architecture
      button type="button" data-gallery-subject="transit" aria-pressed="false" Transit

- # thumbnail gallery
div[class="my-gallery grid gallery-editorial are-images-unloaded" data-navigation-contrast="light" data-gallery-total=@photo_count itemscope="" itemtype="http://schema.org/ImageGallery"]
  .grid-sizer
  - @photos.each_with_index do |photo, index|
    figure.image.grid-item data-gallery-item="" data-gallery-index=(index + 1) data-gallery-subjects=Array(photo[:gallery_subjects]).join(' ') itemprop="associatedMedia" itemscope="" itemtype="http://schema.org/ImageObject"
      a data-pswp-height=photo[:photo_large][:height] data-pswp-width=photo[:photo_large][:width] href=photo[:photo_large][:url] itemprop="contentUrl"
        img alt="#{photo[:description]}" decoding="async" height="#{photo[:photo_large][:height]}" itemprop="thumbnail" loading=(index > 5 ? "lazy" : "eager") src="#{photo[:photo_large][:url]}" width="#{photo[:photo_large][:width]}"
        .photography-card-chrome aria-hidden="true"
          span.photography-card-number = format('%02d', index + 1)
          span.photography-card-open View frame
      figcaption itemprop="caption description"
        = photo[:description]

- if @gallery_has_more
  = link_to 'Next page', photography_path(seed: @gallery_seed, page: @gallery_page + 1), class: 'pagination-next glass-button rounded-full'

.page-load-status aria-live="polite"
  .infinite-scroll-request role="status"
    .infinite-scroll-spinner aria-hidden="true"
    span.sr-only Loading more photographs
